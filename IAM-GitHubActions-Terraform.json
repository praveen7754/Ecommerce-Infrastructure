{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_TERRAFORM_STATE_BUCKET"
    },
    {
      "Sid": "TerraformStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_TERRAFORM_STATE_BUCKET/ecommerce/terraform.tfstate",
        "arn:aws:s3:::REPLACE_WITH_TERRAFORM_STATE_BUCKET/ecommerce/terraform.tfstate.tflock"
      ]
    },
    {
      "Sid": "TerraformECRSmokeTest",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:PutImageScanningConfiguration",
        "ecr:PutImageTagMutability"
      ],
      "Resource": "arn:aws:ecr:us-east-1:743320495203:repository/ecommerce-terraform-test"
    }
  ]
}
